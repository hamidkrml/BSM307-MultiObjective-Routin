# Docker ignore file
# Bu dosyalar Docker image'e kopyalanmaz

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore

# Documentation (build edilmiş)
docs/_build/
docs/.doctrees/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Results (mount edilir, image'e gerek yok)
experiments/results/*.json
experiments/results/*.csv
experiments/plots/*.png
experiments/plots/*.pdf

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

